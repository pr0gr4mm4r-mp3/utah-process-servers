{
  "name": "Case",
  "type": "object",
  "properties": {
    "case_number": {
      "type": "string",
      "description": "Client-provided case or file number"
    },
    "attorney": {
      "type": "string",
      "description": "Plaintiff or petitioner name"
    },
    "attorney_name": {
      "type": "string",
      "description": "Name of the representing attorney (optional)"
    },
    "firm": {
      "type": "string",
      "description": "Law firm or organization"
    },
    "email": {
      "type": "string",
      "description": "Client email address"
    },
    "phone": {
      "type": "string",
      "description": "Client phone number"
    },
    "service_type": {
      "type": "string",
      "description": "Type of process service requested"
    },
    "county": {
      "type": "string",
      "description": "Utah county for service"
    },
    "respondent_name": {
      "type": "string",
      "description": "Name of the respondent or defendant"
    },
    "respondent_address": {
      "type": "string",
      "description": "Known address of respondent"
    },
    "additional_addresses": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Additional known addresses for the respondent"
    },
    "additional_respondents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the additional respondent or defendant"
          },
          "address": {
            "type": "string",
            "description": "Address for this additional respondent"
          },
          "attempts": {
            "type": "integer",
            "default": 0,
            "description": "Number of service attempts made for this respondent"
          }
        }
      },
      "description": "Additional respondents or defendants on the same case file"
    },
    "respondent_employer": {
      "type": "string",
      "description": "Respondent employer or company name"
    },
    "respondent_employer_address": {
      "type": "string",
      "description": "Respondent work/employer address"
    },
    "special_instructions": {
      "type": "string",
      "description": "Any special instructions for service"
    },
    "document_urls": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Array of uploaded document objects {name, url}"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "delivered",
        "pending_proof",
        "failed"
      ],
      "default": "pending",
      "description": "Current status of the case"
    },
    "served_addresses": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Keys of addresses marked as served (e.g. 'primary', 'additional-0', 'respondent-0')"
    },
    "address_results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "Address key matching served_addresses keys (e.g. 'primary', 'additional-0', 'respondent-0')"
          },
          "status": {
            "type": "string",
            "enum": [
              "served",
              "failed"
            ],
            "description": "Per-address outcome"
          },
          "served_at": {
            "type": "string",
            "format": "date-time",
            "description": "When service was completed at this address"
          }
        }
      },
      "description": "Per-address service results with served_at timestamps"
    },
    "checkout_id": {
      "type": "string",
      "description": "Checkout session ID"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "paid"
      ],
      "default": "pending",
      "description": "Payment status"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "stripe",
        "paypal",
        "zelle",
        "venmo",
        "base44",
        "other"
      ],
      "description": "Payment method used"
    },
    "payment_received": {
      "type": "boolean",
      "default": false,
      "description": "Whether payment has been received and verified by admin"
    },
    "package_name": {
      "type": "string",
      "description": "Name of the service package purchased"
    },
    "package_price": {
      "type": "string",
      "description": "Price paid for the service package"
    },
    "service_attempts": {
      "type": "integer",
      "default": 0,
      "description": "Number of service attempts made (for the primary respondent)"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date and time the case was submitted"
    },
    "delivered_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date and time documents were delivered"
    },
    "notes": {
      "type": "string",
      "description": "Internal admin notes"
    }
  },
  "required": [
    "attorney",
    "email",
    "service_type",
    "county",
    "respondent_name"
  ]
}